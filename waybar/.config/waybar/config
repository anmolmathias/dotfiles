{
    "layer": "bottom",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "modules-left": ["sway/workspaces","wlr/taskbar"],
    "modules-center": [],
    "modules-right": ["mpris", "sway/mode", "network", "bluetooth", "idle_inhibitor", "custom/theme-mode", "pulseaudio", "battery", "custom/mako", "clock"],

    "sway/workspaces": {
        "disable-scroll": false,
        "format": "{name}"
    },

"wlr/taskbar": {
	"format": "{icon}  {title:.30}",
	"icon-size": 14,
	"icon-theme": "Yaru",
	"tooltip-format": "{title}",
	"on-click": "minimize-raise",
	"on-click-middle": "close"
},



"mpris": {
        "format": "<span size='x-large' rise='-1200' color='#a56de2'>{player_icon}</span> {artist} - {title}",
        "format-paused": "{status_icon} {artist} - {title}",
        "max-length": 80,
        "player-icons": {
            "default": " ",
	    "Feishin": "󰎆 ",
            "spotify": " ",
	    "mpv": " "
        },
        "status-icons": {
            "paused": "  "
        },
        "artist-len": 25,
        "title-len": 30,
	"ignored-players":["kdeconnect"]
    },

    "sway/mode": {
        "format": "  "
    },
    "clock": {
        "format": "{:%a %b %d  %H:%M}",
	"tooltip": true,
	"tooltip-format": "<tt><small><span size='10pt' font='PragmataPro'>{calendar}</span></small></tt>",
	"calendar": {
		"mode": "month",
		"format": {
                	"months": "<span color='#f4679d'><b>{}</b></span>",
                        "days": "<span color='#fafafa'><b>{}</b></span>",
                	"weekdays": "<span color='#9bdb4d'><b>{}</b></span>",
                	"today": "<span color='#f9c440'><b>{}</b></span>"
            	}
	},
	"actions": {
		"on-scroll-up": "shift_up",
		"on-scroll-down": "shift_down"
	}
    },


 "network": {
        "format": "",
        "format-ethernet": "󰈀",
        "format-wifi": "󰖩",
        "format-disconnected": "󱚼",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected",
	"on-click": "foot nmtui"
    },

    "pulseaudio": {
        "format": "{icon}",
	"format-muted": " ",
	"format-icons": {
		"headphone": "",
		"headset": "",
		"hifi": "󰓃",
		"default": ["", "", ""]
	},
	"on-click": "foot pulsemixer",
	"on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
	"on-scroll-up": "paplay ~/.local/share/sounds/elementary/stereo/audio-volume-change.wav && wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
	"on-scroll-down": "paplay ~/.local/share/sounds/elementary/stereo/audio-volume-change.wav && wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
	"tooltip-format": "Vol: {volume}",
	"max-volume": "100"
    },


"bluetooth": {
	"format": "󰂯",
	"format-disabled": "󰂲",
	"format-connected": "",
	"on-click": "blueman-manager"
},

"idle_inhibitor": {
	"format": "{icon}",
	"format-icons": {
		"activated": "",
		"deactivated": ""
	},
	"timeout": 180
},

"custom/theme-mode": {
	"format": "",
	"tooltip": false,
	"on-click": "bash /home/nml/.local/bin/switch-theme-mode"
},
    
    "battery": {
        "interval": 60,
	"states": {
		"warning": 30,
		"critical": 15,
		"default": 100
	},
	"events": {
		"on-discharging-warning": "notify-send -u low '󰁼   Low Battery'",
		"on-discharging-critical": "notify-send -u critical '󰂃   Battery almost empty'"
	},
        "format": "{icon}",
        "format-icons": {
		"default": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
		"charging": ["󰢟 ", "󰢜 ", "󰂆 ", "󰂇 ", "󰂈 ", "󰢝 ", "󰂉 ", "󰢞 ", "󰂊 ", "󰂋 ", "󰂄 "]
    },
        "tooltip-format": "{capacity}%"
    },

"custom/mako": {
    "exec": "~/.config/waybar/scripts/mako.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 2, // Updates every 2 seconds
    "on-click": "makoctl mode -t do-not-disturb && pkill -SIGRTMIN+8 waybar", // Added -SIGRTMIN
    "on-click-right": "makoctl dismiss -a && pkill -SIGRTMIN+8 waybar",
    "signal": 8
}
}
